@charset "utf-8";

@keyframes disappear { 
  0% { opacity: 1; }
  100% { opacity: 0; pointer-events: none; }
}

@keyframes shake { 
  0% { transform: translate3d(-1%, -1%, 0px); }
  50% { transform: translate3d(-1%, 1%, 0px); }
  75% { transform: translate3d(1%, 1%, 0px); }
  100% { transform: translate3d(1%, -1%, 0px); }
}

.lyrics-enter-active { opacity: 1; transition: 1s ease-out; }

.lyrics-enter { opacity: 0; transform: translateY(12px); }

@keyframes pulse-green { 
  0% { box-shadow: rgba(0, 180, 0, 0.7) 0px 0px; }
  70% { box-shadow: rgba(255, 82, 82, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(255, 82, 82, 0) 0px 0px; }
}

@keyframes pulse-purple { 
  0% { box-shadow: rgba(133, 48, 242, 0.7) 0px 0px; }
  70% { box-shadow: rgba(255, 82, 82, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(255, 82, 82, 0) 0px 0px; }
}

@keyframes pulse-yellow { 
  0% { box-shadow: rgba(255, 193, 7, 0.7) 0px 0px; }
  70% { box-shadow: rgba(255, 82, 82, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(255, 82, 82, 0) 0px 0px; }
}

@keyframes pulse-red { 
  0% { box-shadow: rgba(255, 82, 82, 0.7) 0px 0px; }
  70% { box-shadow: rgba(255, 82, 82, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(255, 82, 82, 0) 0px 0px; }
}

@keyframes pulse-white { 
  0% { box-shadow: rgba(255, 255, 255, 0.7) 0px 0px; transform: scale(0.95); }
  70% { box-shadow: rgba(255, 255, 255, 0) 0px 0px 0px 10px; transform: scale(1); }
  100% { box-shadow: rgba(255, 255, 255, 0) 0px 0px; transform: scale(0.95); }
}

@keyframes pulse-custom { 
  0% { box-shadow: rgba(5, 39, 65, 0.85) 0px 0px; }
  70% { box-shadow: rgba(255, 82, 82, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(255, 82, 82, 0) 0px 0px; }
}

.slide-enter-active { animation: 0.7s ease 0s 1 normal none running slide-left; }

.slide-leave-active { animation: 0.2s ease 0s 1 reverse none running slide-left; position: absolute; }

@keyframes slide-left { 
  0% { transform: translate(150%); }
  100% { transform: translate(0px); }
}

@keyframes fade-off { 
  100% { opacity: 0; }
}

@keyframes loading { 
  100% { background-size: 100% 100%; }
}

.fade-enter-active, .fade-leave-active { transition: opacity 0.5s; }

.fade-enter, .fade-leave-to { opacity: 0; }

.slide-fade-enter-active { transition: 0.3s; }

.slide-fade-enter, .slide-fade-leave-to { opacity: 0; transform: translate(10px); }

.slide-up-enter-active { transition: 0.3s; }

.slide-up-enter, .slide-up-leave-to { opacity: 0; transform: translateY(-100px); }

@keyframes blink { 
  0% { opacity: 0.2; }
  20% { opacity: 1; }
  100% { opacity: 0.2; }
}

@keyframes bounce { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

@keyframes shimmer { 
  0% { background-position: -200% 0px; }
  100% { background-position: 200% 0px; }
}
